# OpenRouter API Configuration
# Get your free API key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY-HERE

# LLM Model
# Free option: meta-llama/llama-3.1-70b-instruct:free
# Quality option: anthropic/claude-3.5-sonnet
LLM_MODEL=meta-llama/llama-3.1-70b-instruct:free

# Verbose output
VERBOSE_MODE=True

# College Scorecard API (for scripts/build_colleges.py). DEMO_KEY works for the
# handful of calls the build makes; get a free key at https://api.data.gov/signup/
SCORECARD_API_KEY=DEMO_KEY

# Admin token required (as the X-Admin-Token header) to call the operator-only
# endpoints /api/escalations and /api/metrics. Unset = those endpoints always
# reject requests (fail closed). Set to a long random value in any environment
# where a reviewer needs to use them.
ADMIN_TOKEN=
